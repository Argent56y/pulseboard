{
  "name": "pulseboard",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev --host 127.0.0.1 --port 3000",
    "dev:next": "next dev",
    "build": "vinext build",
    "build:next": "next build --webpack",
    "start": "node ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --ip 127.0.0.1 --inspector-port 0",
    "start:next": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "supabase test db",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@types/papaparse": "^5.3.16",
    "@xyflow/react": "12.11.6",
    "clsx": "2.1.1",
    "geist": "1.7.2",
    "lucide-react": "1.43.0",
    "motion": "13.2.0",
    "next": "16.3.4",
    "papaparse": "^5.5.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@cloudflare/workers-types": "^4.20260515.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "^0.5.26",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "29.0.1",
    "react-server-dom-webpack": "^19.3.0",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vinext": "^1.0.0-beta.5",
    "vite": "^8.0.13",
    "vitest": "5.0.0",
    "wrangler": "^4.92.0"
  }
